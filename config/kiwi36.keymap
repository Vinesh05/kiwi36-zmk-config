#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define UPPER 2

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp EXCL>;
        };

        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N2>, <&kp AT>;
        };

        td3: tap_dance_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N3>, <&kp HASH>;
        };

        td4: tap_dance_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N4>, <&kp DOLLAR>;
        };

        td5: tap_dance_5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N5>, <&kp PRCNT>;
        };

        td6: tap_dance_6 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N6>, <&kp CARET>;
        };

        td7: tap_dance_7 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N7>, <&kp AMPS>;
        };

        td8: tap_dance_8 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N8>, <&kp STAR>;
        };

        td9: tap_dance_9 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N9>, <&kp LPAR>;
        };

        td10: tap_dance_10 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N0>, <&kp RPAR>;
        };

        td11: tap_dance_11 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp APOS>, <&kp DQT>;
        };

        td12: tap_dance_12 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp PIPE>, <&kp BSLH>;
        };

        soft_off {
            hold-time-ms = <5000>; // Only turn off it the key is held for 5 seconds or longer.
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";

            // ------------------------------------------------------         ---------------------------------------------
            // |  ESC-Q   |    W     |     E     |     R      |  T  |         |  Y  |      U      |     I     |  O  |  P  |
            // ------------------------------------------------------         ---------------------------------------------
            // |  LGUI-A  |  LALT-S  |  LCTRL-D  |  LSHIFT-F  |  G  |         |  H  |  LSHIFT-J   |  LCTRL-K  |  L  |  ;  |
            // ------------------------------------------------------          --------------------------------------------
            // |     Z    |     X    |     C     |     V      |  B  |         |  N  |      M      |     ,     |  .  |  /  |
            // ------------------------------------------------------         ---------------------------------------------
            //                                    | GUI | LWR | SPC |         | ENT | RSE  | ALT |
            //                                    -------------------         --------------------

            bindings = <
&kp Q           &kp W           &kp F        &kp P         &kp B  &kp J  &kp L         &kp U        &kp Y            &kp SEMICOLON
&hm LEFT_GUI A  &hm LEFT_ALT R  &hm LCTRL S  &hm LSHIFT T  &kp G  &kp M  &hm RSHIFT N  &hm RCTRL E  &hm RIGHT_ALT I  &hm RIGHT_GUI O
&kp Z           &kp X           &kp C        &kp D         &kp V  &kp K  &kp H         &kp COMMA    &kp DOT          &kp FSLH
                                &kp ESC      &kp BSPC      &mo 1  &mo 2  &kp SPACE     &kp ENTER
            >;
        };

        lower_layer {
            display-name = "LOWER";

            // ---------------------------------------   --------------------------------
            // |  1 !  |    2 @    | 3 # | 4 $ | 5 % |   | 6 ^ |  7 & | 8 * | 9   |  0  |
            // ---------------------------------------   --------------------------------
            // |  TAB  |  LGUI(E)  |     | PRNT| CAP |   |  -  |  =   | lbkt| rbkt| ' " |
            // ---------------------------------------   --------------------------------
            // | delete|           |     | PST | CAD |   |  _  |  +   | lbrc| rbrc|  |  |
            // ---------------------------------------   --------------------------------
            //                     | GUI | LWR | SPC |   | ENT | RSE  | ALT |
            //                     -------------------   --------------------

            bindings = <
&td1     &td2      &kp UP_ARROW  &td4             &td5      &bt BT_SEL 0  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &bt BT_SEL 3
&kp TAB  &kp LEFT  &kp DOWN      &kp RIGHT        &kp CAPS  &bt BT_SEL 1  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &bt BT_SEL 4
&kp DEL  &none     &kp DEL       &kp PRINTSCREEN  &none     &bt BT_SEL 2  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0
                   &kp ESC       &kp BACKSPACE    &mo 1     &mo 2         &kp SPACE        &kp ENTER
            >;
        };

        raise_layer {
            display-name = "UPPER";

            // ---------------------------------   ----------------------------------------------
            // | soft  |     |     | ext | ext |   |        |         |  UP    |         |delete|
            // ---------------------------------   ----------------------------------------------
            // |  CLR  | bt1 | bt2 | bt3 |     |   |  HOME  |  LEFT   |  DOWN  |  RIGHT  |      |
            // ---------------------------------   ----------------------------------------------
            // | stdulk|     |     |     |     |   |        |         |        |   END   |      |
            // ---------------------------------   ----------------------------------------------
            //               | GUI | LWR | SPC |   | ENT | RSE  | ALT | 
            //               -------------------   --------------------

            bindings = <
&kp EXCLAMATION  &kp AT_SIGN     &kp HASH          &kp DOLLAR            &kp PERCENT    &kp CARET         &kp AMPERSAND          &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp BACKSLASH    &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LESS_THAN  &kp GREATER_THAN  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE       &kp SLASH
&kp PIPE         &kp TILDE       &kp GRAVE         &kp UNDERSCORE        &kp MINUS      &kp PLUS          &kp EQUAL              &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE      &kp QUESTION
                                 &kp ESCAPE        &kp BACKSPACE         &mo 1          &mo 2             &kp SPACE              &kp ENTER
            >;
        };

        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
    };
};
